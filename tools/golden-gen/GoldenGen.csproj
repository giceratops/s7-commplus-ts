<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0649;CS0169;CS0414;CS8981;SYSLIB0001</NoWarn>
    <Deterministic>true</Deterministic>
    <!-- location of the ORIGINAL C# sources (compiled in place via links, never modified); override with -p:S7Src=... -->
    <S7Src Condition="'$(S7Src)'==''">$(MSBuildThisFileDirectory)../../../S7CommPlusDriver/src</S7Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="Interp.cs;Gen*.cs" />
    <Compile Include="$(S7Src)/S7CommPlusDriver/Core/*.cs" Exclude="$(S7Src)/S7CommPlusDriver/Core/CommRessources.cs" />
    <Compile Include="$(S7Src)/S7CommPlusDriver/ClientApi/PlcTag.cs" />
    <Compile Include="$(S7Src)/S7CommPlusDriver/ClientApi/PlcTagQC.cs" />
    <Compile Include="$(S7Src)/S7CommPlusDriver/ClientApi/ItemAddress.cs" />
    <Compile Include="$(S7Src)/S7CommPlusDriver/Alarming/Alarms*.cs" Exclude="$(S7Src)/S7CommPlusDriver/Alarming/AlarmsHandler.cs" />
    <Compile Include="$(S7Src)/Zlib.net/*.cs" Exclude="$(S7Src)/Zlib.net/AssemblyInfo.cs" />
  </ItemGroup>
</Project>
