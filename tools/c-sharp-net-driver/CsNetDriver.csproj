<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0649;CS0169;CS0414;CS8981;SYSLIB0001;SYSLIB0021;SYSLIB0023;CS0108;CS0114</NoWarn>
    <!-- Native.cs picks the 64 bit DLL names (libssl-3-x64.dll) with _WIN64; Program.cs maps them to libssl.so.3 -->
    <DefineConstants>$(DefineConstants);_WIN64</DefineConstants>
    <!-- location of the ORIGINAL C# sources (compiled in place via links, never modified); override with -p:S7Src=... -->
    <S7Src Condition="'$(S7Src)'==''">$(MSBuildThisFileDirectory)../../../S7CommPlusDriver/src</S7Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(S7Src)/S7CommPlusDriver/**/*.cs" Exclude="$(S7Src)/S7CommPlusDriver/Properties/**;$(S7Src)/S7CommPlusDriver/obj/**;$(S7Src)/S7CommPlusDriver/bin/**" />
    <Compile Include="$(S7Src)/Zlib.net/*.cs" Exclude="$(S7Src)/Zlib.net/AssemblyInfo.cs" />
  </ItemGroup>
</Project>
